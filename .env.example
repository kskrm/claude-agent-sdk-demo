# Claude API キー（https://platform.claude.com/ で取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Discord の Webhook URL
# Discord のチャンネル設定 → 連携サービス → ウェブフック → 新しいウェブフック → URLをコピー
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# 公開先の URL（Discord 通知に載せるリンク。GitHub Pages の URL）
SITE_BASE_URL=https://kskrm.github.io/claude-agent-sdk-demo
